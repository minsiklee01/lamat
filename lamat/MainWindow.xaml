<Window x:Class="lamat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:lamat.Controls"
        mc:Ignorable="d"
        Title="Jarai Typing Trainer" Height="760" Width="860"
        Background="{StaticResource BgBrush}"
        PreviewKeyDown="Window_KeyDown"
        PreviewKeyUp="Window_KeyUp">
    <Grid>

        <!-- ══════════════════════ Home Screen ══════════════════════ -->
        <Grid x:Name="HomePanel">
            <Border Background="{StaticResource SurfaceBrush}"
                    CornerRadius="20"
                    Padding="56,52"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="380">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.35"
                                      BlurRadius="32" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Jarai Keyboard Trainer"
                               FontFamily="Segoe UI"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Choose a mode to start practising"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,36"/>
                    <Button Content="Position Practice"
                            Height="52"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Margin="0,0,0,12"
                            Click="PositionPracticeBtn_Click"/>
                    <Button Content="Word Practice"
                            Height="52"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Margin="0,0,0,12"
                            Click="WordPracticeBtn_Click"/>
                    <Button Content="Sentence Practice"
                            Height="52"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Margin="0,0,0,12"
                            Click="SentencePracticeBtn_Click"/>
                    <Button Content="Paragraph Practice"
                            Height="52"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Click="ParagraphPracticeBtn_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════ File Selector ══════════════════════ -->
        <Grid x:Name="FileSelectPanel" Visibility="Collapsed">
            <Border Background="{StaticResource SurfaceBrush}"
                    CornerRadius="20"
                    Padding="56,44"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="380">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.35"
                                      BlurRadius="32" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Button Content="← Back"
                                Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left"
                                Click="FileSelectBackBtn_Click"/>
                    </Grid>
                    <TextBlock x:Name="FileSelectTitle"
                               FontFamily="Segoe UI"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Choose a practice set"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>
                    <StackPanel x:Name="FileListPanel"/>
                    <StackPanel x:Name="FileSelectCustomSection">
                        <Border Height="1"
                                Background="{StaticResource BorderBrush}"
                                Margin="0,8,0,16"/>
                        <Button Content="Load custom file (.txt)…"
                                Style="{StaticResource GhostButton}"
                                Height="44"
                                FontSize="14"
                                Click="FileSelectCustomBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════ Practice Shell ══════════════════════ -->
        <Grid x:Name="PracticePanel" Visibility="Collapsed">
            <StackPanel Margin="48,32,48,32">

                <!-- Top bar -->
                <Grid Margin="0,0,0,28">
                    <Button Content="← Home"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Click="HomeBtn_Click"/>
                    <TextBlock x:Name="ProgressText"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Target word -->
                <TextBlock x:Name="TargetText"
                           FontFamily="Segoe UI"
                           FontSize="38"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,36"/>

                <!-- ── Word practice section ── -->
                <StackPanel x:Name="KeySequencePanel">

                    <!-- Word flow strip: faded past word → bright current word → fading next words -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="0,0,0,32">
                        <TextBlock x:Name="WordPastWord" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" Opacity="0.35"
                                   VerticalAlignment="Center" TextAlignment="Center"
                                   Margin="0,0,24,0"/>
                        <TextBlock x:Name="WordCurrentWord" FontFamily="Segoe UI" FontSize="38" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock x:Name="WordNextWord1" FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" Opacity="0.40"
                                   VerticalAlignment="Center" TextAlignment="Center"
                                   Margin="24,0,0,0"/>
                        <TextBlock x:Name="WordNextWord2" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" Opacity="0.22"
                                   VerticalAlignment="Center" TextAlignment="Center"
                                   Margin="16,0,0,0"/>
                    </StackPanel>

                    <!-- Expected key badge -->
                    <TextBlock Text="PRESS"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <Border Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="2"
                            CornerRadius="12"
                            Padding="32,14"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,28">
                        <TextBlock x:Name="ExpectedKeyText"
                                   FontFamily="Segoe UI"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Your input -->
                    <TextBlock Text="YOUR INPUT"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="ActualKeyText"
                               FontFamily="Segoe UI"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>

                    <!-- Invisible TextBox: gives Keyman's TSF context a focused input target -->
                    <TextBox x:Name="WordPracticeInputBox"
                             Width="1" Height="1" Opacity="0"
                             IsTabStop="False"/>

                </StackPanel>

                <!-- ── Sentence practice section ── -->
                <StackPanel x:Name="SentencePanel" Visibility="Collapsed">
                    <TextBlock Text="Type each word and press Space to advance"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <Border Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="20,10"
                            HorizontalAlignment="Center"
                            MinWidth="240">
                        <TextBlock x:Name="SentenceInputDisplay"
                                   FontFamily="Segoe UI"
                                   FontSize="22"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <!-- Invisible TextBox: holds keyboard focus so system key routing works -->
                    <TextBox x:Name="SentenceInputBox"
                             Width="1" Height="1" Opacity="0"
                             IsTabStop="False"/>
                </StackPanel>

                <!-- ── Position practice section ── -->
                <StackPanel x:Name="PositionPanel" Visibility="Collapsed">
                    <TextBlock Text="FIND THIS KEY ON THE KEYBOARD"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>
                    <!-- Key flow strip: faded past → bright current → fading next -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock x:Name="PastKey3" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" Opacity="0.12"
                                   VerticalAlignment="Center" Width="36" TextAlignment="Center"/>
                        <TextBlock x:Name="PastKey2" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" Opacity="0.22"
                                   VerticalAlignment="Center" Width="40" TextAlignment="Center"/>
                        <TextBlock x:Name="PastKey1" FontFamily="Segoe UI" FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" Opacity="0.40"
                                   VerticalAlignment="Center" Width="48" TextAlignment="Center"/>
                        <TextBlock x:Name="PositionCurrentKey" FontFamily="Segoe UI" FontSize="44" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" Width="64" TextAlignment="Center"/>
                        <TextBlock x:Name="NextKey1" FontFamily="Segoe UI" FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" Opacity="0.40"
                                   VerticalAlignment="Center" Width="48" TextAlignment="Center"/>
                        <TextBlock x:Name="NextKey2" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" Opacity="0.22"
                                   VerticalAlignment="Center" Width="40" TextAlignment="Center"/>
                        <TextBlock x:Name="NextKey3" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" Opacity="0.12"
                                   VerticalAlignment="Center" Width="36" TextAlignment="Center"/>
                    </StackPanel>
                    <!-- Invisible TextBox: gives Keyman's TSF context a focused input target -->
                    <TextBox x:Name="PositionInputBox"
                             Width="1" Height="1" Opacity="0"
                             IsTabStop="False"/>
                </StackPanel>

                <!-- ── Paragraph practice section ── -->
                <StackPanel x:Name="ParagraphPanel" Visibility="Collapsed">
                    <TextBlock Text="TYPE EACH WORD AND PRESS SPACE TO CHECK IT"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Line flow strip: faded past line → bright current line → fading upcoming lines -->
                    <TextBlock x:Name="ParagraphPrevLine"
                               FontFamily="Segoe UI" FontSize="16"
                               Foreground="{StaticResource TextBrush}" Opacity="0.30"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="680"
                               Margin="0,0,0,14"/>

                    <TextBlock x:Name="ParagraphCurrentLine"
                               FontFamily="Segoe UI" FontSize="26" FontWeight="Bold"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="700"
                               Margin="0,0,0,14"/>

                    <!-- Live typed text for the current line (submitted words + word in progress) -->
                    <Border Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="20,10"
                            HorizontalAlignment="Stretch"
                            MinWidth="500"
                            MaxWidth="760"
                            Margin="0,0,0,14">
                        <TextBlock x:Name="ParagraphInputDisplay"
                                   FontFamily="Segoe UI"
                                   FontSize="22"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="ParagraphNext1"
                               FontFamily="Segoe UI" FontSize="16"
                               Foreground="{StaticResource TextBrush}" Opacity="0.45"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="680"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="ParagraphNext2"
                               FontFamily="Segoe UI" FontSize="15"
                               Foreground="{StaticResource TextBrush}" Opacity="0.35"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="680"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="ParagraphNext3"
                               FontFamily="Segoe UI" FontSize="14"
                               Foreground="{StaticResource TextBrush}" Opacity="0.25"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="680"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="ParagraphNext4"
                               FontFamily="Segoe UI" FontSize="13"
                               Foreground="{StaticResource TextBrush}" Opacity="0.17"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="680"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="ParagraphNext5"
                               FontFamily="Segoe UI" FontSize="12"
                               Foreground="{StaticResource TextBrush}" Opacity="0.10"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="680"/>

                    <!-- Invisible TextBox: holds keyboard focus so system key routing works -->
                    <TextBox x:Name="ParagraphInputBox"
                             Width="1" Height="1" Opacity="0"
                             IsTabStop="False"/>
                </StackPanel>

                <!-- Shared visual keyboard (word practice + position practice) -->
                <controls:JaraiKeyboardControl x:Name="JaraiKeyboard"
                                               Margin="0,20,0,0"
                                               HorizontalAlignment="Center"/>

                <!-- Status / feedback -->
                <TextBlock x:Name="StatusText"
                           FontFamily="Segoe UI"
                           FontSize="14"
                           Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>

            </StackPanel>
        </Grid>

        <!-- ══════════════════════ Mute toggle (always visible) ══════════════════════ -->
        <Button x:Name="MuteButton"
                Content="🔊"
                Style="{StaticResource GhostButton}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,24,0"
                Width="44" Height="36"
                FontSize="16"
                Click="MuteBtn_Click"/>

    </Grid>
</Window>
